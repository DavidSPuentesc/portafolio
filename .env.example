CONTACT_WEBHOOK_URL=https://example.com/your-private-webhook
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me
# CONTENT_DENYLIST: name patterns that must never appear in published content (case-insensitive regex, separated by |). Keep it empty here; set the real list in .env or as a CI secret.
CONTENT_DENYLIST=

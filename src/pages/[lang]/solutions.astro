---
import {getCollection} from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import SolutionCard from '../../components/commercial/SolutionCard.astro'; import CommercialProcess from '../../components/commercial/CommercialProcess.astro'; import { locales, isLocale } from '../../i18n/locales'; export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));} const lang=Astro.params.lang;if(!isLocale(lang))return Astro.redirect('/es/'); const solutions=(await getCollection('solutions'))[0]?.data.items??[];
---
<BaseLayout {lang} title={lang==='es'?'Soluciones tecnológicas B2B — David Puentes':'B2B technology solutions — David Puentes'} description="IoT, asset traceability, and applied AI pilots" canonicalPath={`/${lang}/solutions/`}>
  <header class="solutions-hero section"><p class="eyebrow">B2B / PILOTS</p><h1>{lang==='es'?'Tecnología medible para problemas operativos reales.':'Measurable technology for real operational problems.'}</h1><p>{lang==='es'?'Diseño pilotos de alcance claro que conectan software, electrónica e IA. Empezamos por una métrica verificable antes de escalar.':'I design clearly scoped pilots connecting software, electronics, and AI. We begin with a verifiable metric before scaling.'}</p><a class="button primary" href="#contact">{lang==='es'?'Solicitar diagnóstico':'Request a discovery call'}</a></header>
  <section class="section"><p class="eyebrow">{lang==='es'?'SOLUCIONES INICIALES':'INITIAL SOLUTIONS'}</p><h2>{lang==='es'?'Tres formas de empezar':'Three ways to start'}</h2><div class="solution-grid">{solutions.map(solution=><SolutionCard {solution} {lang}/>)}</div></section>
  <section class="section"><p class="eyebrow">{lang==='es'?'PROCESO':'PROCESS'}</p><h2>{lang==='es'?'Diagnosticar, probar, medir':'Discover, pilot, measure'}</h2><CommercialProcess {lang}/></section>
  <section class="confidentiality section"><h2>{lang==='es'?'Evidencia sin exponer información sensible':'Evidence without exposing sensitive information'}</h2><p>{lang==='es'?'Los casos públicos describen arquitectura, decisiones y resultados permitidos. No publicamos logos, fotografías, credenciales, datos ni detalles internos de empresas aliadas.':'Public cases describe permitted architecture, decisions, and outcomes. We do not publish partner-company logos, photographs, credentials, data, or internal details.'}</p></section>
  <section class="section" id="contact"><p class="eyebrow">{lang==='es'?'SIGUIENTE PASO':'NEXT STEP'}</p><h2>{lang==='es'?'Cuéntame qué proceso quieres mejorar.':'Tell me which process you want to improve.'}</h2><a class="button primary" href="mailto:davidspuentesc@gmail.com">{lang==='es'?'Agendar diagnóstico':'Schedule discovery'} →</a></section>
</BaseLayout>

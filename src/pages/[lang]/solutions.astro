---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SolutionCard from '../../components/commercial/SolutionCard.astro';
import CommercialProcess from '../../components/commercial/CommercialProcess.astro';
import ContactForm from '../../components/contact/ContactForm';
import { resolveContactEndpoint } from '../../lib/contact-endpoint';
import { locales, isLocale } from '../../i18n/locales';
export function getStaticPaths() { return locales.map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang;
if (!isLocale(lang)) return Astro.redirect('/es/');
const es = lang === 'es';
const contactEndpoint = resolveContactEndpoint(import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT);
const data = (await getCollection('solutions'))[0]?.data;
const solutions = data?.items ?? [];
const sectors = data?.sectors[lang] ?? [];

const pilot = es
  ? [
      ['Diagnóstico', 'Una conversación para entender el problema, los usuarios, las restricciones y la métrica de éxito.'],
      ['Piloto', 'Un alcance pequeño con entregables, propiedad intelectual y límites definidos por escrito antes de construir.'],
      ['Medición', 'Resultados frente a la métrica acordada, documentación y una decisión informada sobre el siguiente paso.'],
    ]
  : [
      ['Discovery', 'A conversation to understand the problem, users, constraints, and success metric.'],
      ['Pilot', 'A small scope with deliverables, intellectual property, and limits defined in writing before building.'],
      ['Measurement', 'Results against the agreed metric, documentation, and an informed decision about the next step.'],
    ];
---
<BaseLayout {lang} title={es ? 'Soluciones tecnológicas — David Puentes' : 'Technology solutions — David Puentes'} description={es ? 'Pilotos de datos, IA aplicada, IoT, telemetría y plataformas web respaldados por proyectos públicos.' : 'Data, applied AI, IoT, telemetry, and web-platform pilots backed by public projects.'} canonicalPath={`/${lang}/solutions/`}>
  <header class="solutions-hero section">
    <p class="eyebrow">{es ? 'SOLUCIONES · PILOTOS MEDIBLES' : 'SOLUTIONS · MEASURABLE PILOTS'}</p>
    <h1>{es ? 'Tecnología diseñada alrededor de un problema concreto.' : 'Technology designed around a specific problem.'}</h1>
    <p>{es ? 'Desarrollo pilotos de datos, IA aplicada, IoT, telemetría y plataformas web con alcance claro y evidencia verificable. Cada proyecto nuevo se diseña desde cero y utiliza únicamente información y activos autorizados por el cliente.' : 'I develop data, applied AI, IoT, telemetry, and web-platform pilots with clear scope and verifiable evidence. Every new project is designed from scratch and uses only information and assets authorized by the client.'}</p>
    <div class="hero-actions">
      <a class="button primary" href="#contact">{es ? 'Solicitar diagnóstico' : 'Request a discovery call'}</a>
      <a class="button secondary" href={`/${lang}/projects/`}>{es ? 'Ver proyectos públicos' : 'See public projects'}</a>
    </div>
  </header>

  <section class="section">
    <p class="eyebrow">NUVETRION · {es ? 'INGENIERÍA APLICADA AL NEGOCIO' : 'ENGINEERING FOR BUSINESS'}</p>
    <h2>{es ? 'Seguridad industrial, automatización y sistemas conectados.' : 'Industrial security, automation, and connected systems.'}</h2>
    <p class="section-lede">{es ? 'Mi portafolio empresarial reúne soluciones de electrónica, software y datos para operaciones reales, con un alcance distinto según su madurez.' : 'My business portfolio brings electronics, software, and data solutions to real operations, with scope defined by their maturity.'}</p>
    <div class="skills-grid three">
      <article><p class="eyebrow">{es ? 'IMPLEMENTACIÓN INDUSTRIAL' : 'INDUSTRIAL IMPLEMENTATION'}</p><h3>{es ? 'Alarmas inalámbricas distribuidas' : 'Distributed wireless alarms'}</h3><p>{es ? 'Solución comercializada e instalada en entorno industrial, según el portafolio Nuvetrion: paneles por zona, alertas configurables y supervisión centralizada de conectividad, estados y eventos.' : 'A solution sold and installed in an industrial environment, as documented in the Nuvetrion portfolio: zoned panels, configurable alerts, and central supervision of connectivity, states, and events.'}</p></article>
      <article><p class="eyebrow">{es ? 'EXPERIENCIA DE DESARROLLO' : 'DEVELOPMENT EXPERIENCE'}</p><h3>{es ? 'Plataformas y automatización empresarial' : 'Business platforms and automation'}</h3><p>{es ? 'Experiencia integrando requisitos documentales, contratistas, visitas, permisos, aprobaciones, auditorías y planes de acción en sistemas con perfiles y permisos por rol. Desarrollo de nuevas soluciones a partir de requerimientos propios de cada operación.' : 'Experience integrating document requirements, contractors, visits, permits, approvals, audits, and action plans in systems with role-based profiles and permissions. New solutions are developed from each operation’s own requirements.'}</p></article>
      <article><p class="eyebrow">{es ? 'SOLUCIONES A DESARROLLAR Y VALIDAR' : 'SOLUTIONS TO DEVELOP AND VALIDATE'}</p><h3>{es ? 'Visión artificial y analítica avanzada' : 'Computer vision and advanced analytics'}</h3><p>{es ? 'Propuestas de inspección visual, control de accesos, calidad de datos, detección de anomalías, revisión documental asistida y pronóstico de demanda logística. Cada aplicación requiere datos autorizados, criterios de evaluación y validación propia.' : 'Proposals for visual inspection, access control, data quality, anomaly detection, assisted document review, and logistics demand forecasting. Each application requires authorized data, evaluation criteria, and its own validation.'}</p></article>
    </div>
  </section>

  <section class="section">
    <p class="eyebrow">{es ? 'LÍNEAS DE TRABAJO' : 'LINES OF WORK'}</p>
    <h2>{es ? 'Qué puedo construir y qué evidencia lo respalda' : 'What I can build and the evidence behind it'}</h2>
    <div class="solution-grid">{solutions.map((solution) => <SolutionCard {solution} {lang} />)}</div>
  </section>

  <section class="section">
    <p class="eyebrow">{es ? 'QUÉ RECIBES' : 'WHAT YOU GET'}</p>
    <h2>{es ? 'Un piloto con alcance cerrado y una métrica' : 'A tightly scoped pilot with one metric'}</h2>
    <div class="skills-grid three">{pilot.map(([title, body]) => <article><h3>{title}</h3><p>{body}</p></article>)}</div>
  </section>

  <section class="section">
    <p class="eyebrow">{es ? 'PROCESO' : 'PROCESS'}</p>
    <h2>{es ? 'Diagnosticar, probar, medir' : 'Discover, pilot, measure'}</h2>
    <CommercialProcess {lang} />
  </section>

  <section class="section">
    <p class="eyebrow">{es ? 'SECTORES OBJETIVO' : 'TARGET SECTORS'}</p>
    <h2>{es ? 'Dónde puedo aportar' : 'Where I can contribute'}</h2>
    <ul class="sector-list">{sectors.map((sector) => <li>{sector}</li>)}</ul>
  </section>

  <section class="confidentiality section">
    <h2>{es ? 'Confidencialidad desde el diseño' : 'Confidentiality by design'}</h2>
    <p>{es ? 'No reutilizo código, datos, diseños ni procesos confidenciales de terceros. La evidencia comercial de este sitio proviene de proyectos públicos o independientes.' : 'I do not reuse third-party confidential code, data, designs, or processes. Commercial evidence on this site comes from public or independent projects.'}</p>
  </section>

  <section class="section" id="contact">
    <p class="eyebrow">{es ? 'SIGUIENTE PASO' : 'NEXT STEP'}</p>
    <h2>{es ? 'Cuéntame qué problema quieres resolver.' : 'Tell me which problem you want to solve.'}</h2>
    <p class="section-lede">{es ? 'Respondo con preguntas de diagnóstico, un alcance inicial y una forma concreta de medir el resultado.' : 'I reply with discovery questions, an initial scope, and a concrete way to measure the outcome.'}</p>
    <ContactForm client:idle locale={lang} intent="business" endpoint={contactEndpoint} />
  </section>
</BaseLayout>

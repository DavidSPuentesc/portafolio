---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { locales, isLocale } from '../../i18n/locales';
export function getStaticPaths(){ return locales.map(lang=>({params:{lang}})); } const lang = Astro.params.lang; if(!isLocale(lang)) return Astro.redirect('/es/');
---
<BaseLayout {lang} title={lang==='es'?'Inicio':'Home'} description={lang==='es'?'Portafolio de ingeniería, IA e IoT de David Puentes.':'David Puentes engineering, AI, and IoT portfolio.'} canonicalPath={`/${lang}/`}><h1>{lang==='es'?'Ingeniería para sistemas inteligentes y reales.':'Engineering for intelligent, real-world systems.'}</h1></BaseLayout>

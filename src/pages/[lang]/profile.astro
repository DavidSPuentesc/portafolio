---
import {getCollection} from 'astro:content'; import BaseLayout from '../../layouts/BaseLayout.astro'; import AgenticWorkflow from '../../components/ai/AgenticWorkflow.astro'; import ExperienceTimeline from '../../components/profile/ExperienceTimeline.astro'; import CertificationGrid from '../../components/profile/CertificationGrid.astro'; import { locales, isLocale } from '../../i18n/locales'; export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));} const lang=Astro.params.lang;if(!isLocale(lang))return Astro.redirect('/es/'); const experience=(await getCollection('experience')).sort((a,b)=>a.data.order-b.data.order); const certificates=(await getCollection('certifications'))[0]?.data.items??[]; const cv=lang==='es'?'/cv/david-puentes-cv-es.pdf':'/cv/david-puentes-cv-en.pdf';
---
<BaseLayout {lang} title={lang==='es'?'Perfil profesional — David Puentes':'Professional profile — David Puentes'} description="Software, AI, electronics, IoT and scientific computing" canonicalPath={`/${lang}/profile/`}>
<header class="profile-intro section"><p class="eyebrow">{lang==='es'?'PERFIL PROFESIONAL':'PROFESSIONAL PROFILE'}</p><h1>{lang==='es'?'Ingeniería de software conectada con el mundo físico.':'Software engineering connected to the physical world.'}</h1><p>{lang==='es'?'Desarrollo productos web, sistemas IoT y flujos de IA con agentes y subagentes. Integro skills, herramientas, control de contexto y manejo consciente de tokens; mantengo trazabilidad y validación humana en decisiones sensibles. También trabajo con visión artificial, electrónica y computación científica.':'I build web products, IoT systems, and AI workflows with agents and subagents. I integrate skills, tools, context control, and deliberate token management while keeping traceability and human validation for sensitive decisions. My work also spans computer vision, electronics, and scientific computing.'}</p><a class="button primary" href={cv} download>{lang==='es'?'Descargar CV':'Download CV'} ↓</a></header>
<section class="section"><p class="eyebrow">AGENTIC AI</p><h2>{lang==='es'?'IA aplicada con control de ingeniería':'Applied AI with engineering control'}</h2><AgenticWorkflow {lang}/></section>
<section class="section"><p class="eyebrow">{lang==='es'?'EXPERIENCIA':'EXPERIENCE'}</p><h2>{lang==='es'?'Trayectoria profesional':'Professional journey'}</h2><ExperienceTimeline entries={experience} {lang}/></section>
<section class="section"><p class="eyebrow">{lang==='es'?'CAPACIDADES':'CAPABILITIES'}</p><h2>{lang==='es'?'Del firmware al producto digital':'From firmware to digital product'}</h2><div class="skills-grid"><article><h3>AI & Automation</h3><p>{lang==='es'?'Agentes, subagentes, skills, RAG, prompts, presupuestos de tokens y visión artificial.':'Agents, subagents, skills, RAG, prompting, token budgets, and computer vision.'}</p></article><article><h3>Software & Data</h3><p>TypeScript, React, Python, Django, Flask, SQL, APIs, Docker</p></article><article><h3>Electronics & IoT</h3><p>ESP32, C++, LoRa, BLE, sensores, instrumentación, Edge AI</p></article><article><h3>Cloud & Security</h3><p>Terraform, AWS, CI/CD, privacidad y observabilidad</p></article></div></section>
<section class="section"><p class="eyebrow">{lang==='es'?'FORMACIÓN CONTINUA':'CONTINUOUS LEARNING'}</p><h2>{lang==='es'?'Certificaciones':'Certifications'}</h2><CertificationGrid items={certificates} {lang}/></section>
</BaseLayout>

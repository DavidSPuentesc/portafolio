---
import type { Locale } from '../../i18n/locales';
const { lang } = Astro.props as { lang: Locale };
const es = lang === 'es';
const smartSense = `/${lang}/projects/smartsense/`;
const sensorDashboard = `/${lang}/projects/sensor-dashboard/`;
const metrics = [
  { value: '51K+', label: es ? 'muestras documentadas' : 'documented samples', context: es ? 'Evidencia pública de SmartSense' : 'Public SmartSense evidence', href: smartSense },
  { value: '32', label: es ? 'días de registro' : 'days of records', context: es ? 'Histórico local del prototipo' : 'Prototype local history', href: smartSense },
  { value: '3', label: es ? 'nodos de medición' : 'measurement nodes', context: es ? 'PT100, ESP32 y LoRa' : 'PT100, ESP32, and LoRa', href: smartSense },
  { value: 'E2E', label: es ? 'cadena IoT pública' : 'public IoT chain', context: es ? 'Sensor a API, base de datos y dashboard' : 'Sensor to API, database, and dashboard', href: sensorDashboard },
];
---
<section class="metric-strip" aria-label={es ? 'Resultados verificables' : 'Verifiable results'}>
  {metrics.map((metric) => (
    <div>
      <a href={metric.href}><strong>{metric.value}</strong><span>{metric.label}</span><small>{metric.context}</small></a>
    </div>
  ))}
</section>

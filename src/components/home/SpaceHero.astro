---
import { ui } from '../../i18n/ui'; import { localizedPath, type Locale } from '../../i18n/locales'; const {lang}=Astro.props as {lang:Locale}; const t=ui[lang].hero;
---
<section class="space-hero"><div class="hero-orbs" aria-hidden="true"><i class="orb orb-cyan" data-parallax data-speed="0.18"></i><i class="orb orb-violet" data-parallax data-speed="0.3"></i><i class="orb orb-blue" data-parallax data-speed="0.1"></i></div><div class="hero-content"><p class="eyebrow">{t.eyebrow}</p><h1>{t.title}</h1><p class="lede">{t.description}</p><div class="hero-actions"><a class="button primary" href={localizedPath(lang,'/profile/')}>{t.work}</a><a class="button secondary" href={localizedPath(lang,'/solutions/')}>{t.business}</a></div></div><div class="scroll-cue" aria-hidden="true"></div></section>

---
import type { Locale } from '../../i18n/locales';
const { lang } = Astro.props as { lang: Locale };
const es = lang === 'es';
const areas = es ? [
  { number: '01', title: 'Optimización y computación científica', body: 'GenATC conecta preparación de corpus, algoritmos genéticos y análisis estilométrico sobre aproximadamente dos millones de sílabas. La simulación de partículas añade cálculo de energía, muestreo Monte Carlo y restricciones geométricas.', tags: ['Algoritmos genéticos', 'Monte Carlo', 'Python científico'], path: '/projects/genatc/', link: 'Explorar la investigación' },
  { number: '02', title: 'Software empresarial interconectado', body: 'He construido y reconstruido módulos para una plataforma multiempresa: contratistas y subcontratistas, requisitos documentales, ingresos, visitas, permisos de trabajo, auditorías y planes de acción. Flujos conectados con roles, aprobaciones y trazabilidad.', tags: ['Modelado de dominio', 'Roles y seguridad', 'MVC · SOLID'], path: '/profile/', link: 'Ver mi responsabilidad técnica' },
  { number: '03', title: 'Electrónica, redes y operación industrial', body: 'Diseño de sistemas completos: instrumentación y firmware, comunicaciones inalámbricas, gateways, almacenamiento y supervisión. SmartSense reúne hardware, operación local y análisis; Nuvetrion presenta además una solución de alarmas inalámbricas instalada en entorno industrial.', tags: ['Sistemas distribuidos', 'Firmware y protocolos', 'Integración industrial'], path: '/solutions/', link: 'Explorar soluciones empresariales' },
] : [
  { number: '01', title: 'Optimization and scientific computing', body: 'GenATC connects corpus preparation, genetic algorithms, and stylometric analysis across approximately two million syllables. Particle simulation adds energy calculations, Monte Carlo sampling, and geometric constraints.', tags: ['Genetic algorithms', 'Monte Carlo', 'Scientific Python'], path: '/projects/genatc/', link: 'Explore the research' },
  { number: '02', title: 'Connected business software', body: 'I have built and rebuilt modules for a multi-company platform: contractors and subcontractors, document requirements, access, visits, work permits, audits, and action plans. Connected workflows with roles, approvals, and traceability.', tags: ['Domain modeling', 'Roles and security', 'MVC · SOLID'], path: '/profile/', link: 'See my technical responsibilities' },
  { number: '03', title: 'Electronics, networks, and industrial operations', body: 'Complete system design: instrumentation and firmware, wireless communications, gateways, storage, and supervision. SmartSense brings together hardware, local operation, and analysis; Nuvetrion also presents a wireless alarm solution installed in an industrial environment.', tags: ['Distributed systems', 'Firmware and protocols', 'Industrial integration'], path: '/solutions/', link: 'Explore business solutions' },
];
---
<section class="section engineering-depth">
  <p class="eyebrow">{es ? 'PROFUNDIDAD TÉCNICA' : 'ENGINEERING DEPTH'}</p>
  <h2>{es ? 'De un problema complejo a un sistema que funciona.' : 'From a complex problem to a working system.'}</h2>
  <p class="section-lede">{es ? 'Investigación, desarrollo empresarial y sistemas físicos. Mi trabajo conecta algoritmos, datos, electrónica y decisiones de arquitectura.' : 'Research, business software, and physical systems. My work connects algorithms, data, electronics, and architectural decisions.'}</p>
  <div class="depth-grid">
    {areas.map(area => <article><span class="depth-number">{area.number}</span><h3>{area.title}</h3><p>{area.body}</p><ul>{area.tags.map(tag => <li>{tag}</li>)}</ul><a href={`/${lang}${area.path}`}>{area.link} →</a></article>)}
  </div>
</section>
<style>
  .depth-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem}
  article{display:flex;flex-direction:column;padding:clamp(1.3rem,3vw,2.2rem);border:1px solid rgba(130,170,220,.25);border-radius:1.2rem;background:linear-gradient(145deg,rgba(58,100,153,.16),rgba(12,20,37,.35))}
  .depth-number{font-size:2.4rem;font-weight:700;color:#8ccaff;letter-spacing:-.05em}
  h3{font-size:1.4rem;line-height:1.3;margin:1rem 0}p{line-height:1.75}ul{display:flex;flex-wrap:wrap;gap:.5rem;list-style:none;padding:0;margin:1rem 0 1.5rem}li{font-size:.78rem;padding:.35rem .6rem;border:1px solid rgba(130,170,220,.25);border-radius:2rem}a{margin-top:auto;color:#a8dcff;font-weight:600}
  @media(max-width:900px){.depth-grid{grid-template-columns:1fr}}
</style>

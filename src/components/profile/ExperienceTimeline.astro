---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../i18n/locales';
const { entries, lang } = Astro.props as { entries: CollectionEntry<'experience'>[]; lang: Locale };
---
<div class="timeline">
  {entries.map(({ data }) => (
    <article>
      <p class="eyebrow">{data.period[lang]}</p>
      <h3>{data.role[lang]}</h3>
      <strong>{data.company}</strong>
      <p class="timeline-meta">{data.location}</p>
      <p>{data.summary[lang]}</p>
      {data.metrics.length > 0 && (
        <p class="timeline-metrics">
          {data.metrics.map((metric) => <span><strong>{metric.value}</strong><span>{metric.label[lang]}</span></span>)}
        </p>
      )}
      <ul>{data.highlights[lang].map((item) => <li>{item}</li>)}</ul>
    </article>
  ))}
</div>
